# Example API URL for running Expo directly on the Windows host.
# The recommended `start-fridge.ps1` command detects and exports this value automatically.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000

TRAINING_PROVIDER=local
# Both providers initialize candidates from this fixed pretrained detector.
TRAINING_STARTING_WEIGHTS_PATH=/app/yolo11s.pt
TRAINING_STARTING_MODEL_VERSION=yolo11s-pretrained
# Legacy KAGGLE_STARTING_* variables remain accepted when these are unset.
# Local training requires a real YOLO base dataset with classes.txt, images/, and labels/.
LOCAL_BASE_DATASET_PATH=/app/base_dataset

# Detector promotion policy (all values are fractions between 0 and 1).
MAX_SHARED_MAP50_95_REGRESSION=0.02
MIN_ADDED_CLASS_MAP50_95=0.50
MIN_ADDED_CLASS_PER_CLASS_MAP50_95=0.30

# Required only when TRAINING_PROVIDER=kaggle. Never commit real values.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kgat_token
# Legacy authentication alternative only:
# KAGGLE_KEY=your_legacy_kaggle_api_key
KAGGLE_DATASET_SLUG_PREFIX=fridge9000-training-data
# Base slug; each run appends its unique training_run_id.
KAGGLE_KERNEL_SLUG=your_kaggle_username/fridge9000-remote-yolo-trainer
KAGGLE_MACHINE_SHAPE=NvidiaTeslaT4
KAGGLE_CLI_PATH=kaggle
KAGGLE_POLL_INTERVAL_SECONDS=30
KAGGLE_TIMEOUT_SECONDS=14400
KAGGLE_COMMAND_TIMEOUT_SECONDS=300
